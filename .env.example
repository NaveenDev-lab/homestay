# ──────────────────────────────────────────────────────
# Jeevika Haven — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
# ──────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# CORS — set to your production domain to restrict API access
# e.g. https://www.jeevikahaven.com
ALLOWED_ORIGIN=*

# ── Email (active — Resend) ─────────────────────────────
# Admin email address that receives booking notifications
ADMIN_EMAIL=admin@jeevikahaven.com

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must be a verified domain on Resend in production.
# During development you can use: Jeevika Haven <onboarding@resend.dev>
FROM_EMAIL=Jeevika Haven <noreply@jeevikahaven.com>

# ── reCAPTCHA v2 Invisible ──────────────────────────────
# Get both keys from: https://www.google.com/recaptcha/admin
# Select type: "reCAPTCHA v2 — Invisible reCAPTCHA badge"
#
# SITE_KEY  — public, used in the frontend via BOOKING_CONFIG
# SECRET_KEY — private, used only by the backend API
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
